contas:id_conta -> personagens:id_conta [arrowhead=tee];
clas:id_cla -> personagens:id_cla [arrowtail=teeodot];
personagens:id_personagem -> personagem_skills:id_personagem ;
skills:id_skill -> personagem_skills:id_skill ;
personagens:id_personagem -> inventario:id_personagem ;
itens:id_item -> inventario:id_item ;
skills:id_skill -> quests:id_skill_requisito [arrowtail=teeodot];
