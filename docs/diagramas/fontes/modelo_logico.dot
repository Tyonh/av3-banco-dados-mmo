quests:id_quest -> personagem_quests:id_quest ;
personagens:id_personagem -> ge_ofertas:id_personagem ;
itens:id_item -> ge_ofertas:id_item ;
contas:id_conta -> penalidades:id_conta ;
personagens:id_personagem -> logs_atividade:id_personagem [arrowtail=teeodot];
{rank=same; contas; clas; skills; itens;}
{rank=same; personagens; quests; penalidades;}
{rank=same; personagem_skills; inventario; personagem_quests; ge_ofertas; logs_atividade;}
}